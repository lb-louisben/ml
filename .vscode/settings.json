{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.languageServer": "Pylance",
  "python.terminal.activateEnvironment": true,
  "python.terminal.executeInFileDir": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.useLibraryCodeForTypes": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "scripts/tests"
  ],
  "python.testing.cwd": "${workspaceFolder}",
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.idea": true,
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/.cache": true,
    "**/.jupyter": true,
    "**/node_modules": true,
    "**/outputs": true,
    "**/checkpoints": true,
    "**/runs": true,
    "**/logs": true,
    "**/wandb": true,
    "**/downloads": true,
    "**/*.safetensors": true,
    "**/*.pt": true,
    "**/*.pth": true,
    "**/*.ckpt": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/.cache": true,
    "**/.jupyter": true,
    "**/node_modules": true,
    "**/outputs": true,
    "**/checkpoints": true,
    "**/runs": true,
    "**/logs": true,
    "**/wandb": true,
    "**/downloads": true,
    "**/*.safetensors": true,
    "**/*.pt": true,
    "**/*.pth": true,
    "**/*.ckpt": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.ipynb_checkpoints/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/.cache/**": true,
    "**/.jupyter/**": true,
    "**/node_modules/**": true,
    "**/outputs/**": true,
    "**/checkpoints/**": true,
    "**/runs/**": true,
    "**/logs/**": true,
    "**/wandb/**": true,
    "**/downloads/**": true,
    "**/*.safetensors": true,
    "**/*.pt": true,
    "**/*.pth": true,
    "**/*.ckpt": true
  },
  "editor.gotoLocation.multipleDefinitions": "peek"
}
